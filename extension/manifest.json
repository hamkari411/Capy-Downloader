{
  "manifest_version": 3,
  "name": "Capy YT Downloader",
  "version": "1.0.0",
  "description": "Descarga videos de YouTube en cualquier resolución o solo el audio, usando yt-dlp en tu PC.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Descargar este video",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "capy-ytdl@capybara",
      "strict_min_version": "121.0"
    }
  }
}