{
  "manifest_version": 3,
  "name": "Capy Downloader",
  "version": "1.3.0",
  "description": "Descarga videos de YouTube, TikTok e Instagram en cualquier resolución o solo el audio, usando yt-dlp en tu PC.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Descargar este video",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}